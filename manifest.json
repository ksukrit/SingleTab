{
  "manifest_version": 3,
  "name": "Single Tab Focus",
  "description": "Calm tab limits and visual nudges for staying focused.",
  "version": "0.1.0",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Single Tab Focus",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html"
}
